---
import '../styles/global.css'
import { client } from '../config/client'
import { copy } from '../config/copy'
import { known } from '../lib/todo'
import { schemaType } from '../lib/seo'

interface Props {
  title?: string
  description?: string
}

const { title = copy.title, description = copy.description } = Astro.props

// TODO values never reach the markup as real data.
const phone = known(client.phoneE164)
const email = known(client.email)

const canonical = new URL(Astro.url.pathname, client.siteUrl).href

// Service-area business — areaServed, deliberately no address.
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': schemaType(client.trade),
  name: client.businessName,
  description: client.tagline,
  areaServed: [...new Set([client.baseTown, ...client.areas.map((a) => a.name)])].map((name) => ({
    '@type': 'Place',
    name,
  })),
  ...(phone ? { telephone: phone } : {}),
  ...(email ? { email } : {}),
}
---

<!doctype html>
<html lang="en-GB" style={`--accent: ${client.accent}; --accent-dark: ${client.accentDark};`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={client.siteUrl} />
    <meta property="og:site_name" content={client.businessName} />
    {
      client.ogImage && (
        <>
          <meta property="og:image" content={`${client.siteUrl}${client.ogImage}`} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="pb-24 md:pb-0">
    <slot />
    {
      client.eventEndpoint && (
        <script>
          import { track } from '../lib/track'
          document.addEventListener('click', (event) => {
            const el = (event.target as HTMLElement).closest<HTMLElement>('[data-track-event]')
            if (!el) return
            const name = el.dataset.trackEvent
            if (name !== 'call_click' && name !== 'whatsapp_click') return
            track(name, el.dataset.trackSource ?? '')
          })
        </script>
      )
    }
  </body>
</html>
