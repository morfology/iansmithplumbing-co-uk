---
import ButtonPair from './ButtonPair.astro'
---

<!-- Mobile only. Nobody should hunt for a number while a ceiling drips. -->
<div
  class="fixed inset-x-0 bottom-0 z-50 border-t px-3 py-2 md:hidden"
  style="background: var(--bg); border-color: var(--border); padding-bottom: calc(0.5rem + env(safe-area-inset-bottom, 0px));"
>
  <ButtonPair source="website" compact />
</div>
