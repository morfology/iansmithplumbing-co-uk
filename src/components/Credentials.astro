---
import { client } from '../config/client'
import { known } from '../lib/todo'
import Todo from './Todo.astro'

// undefined = not gas registered at all, so the whole line drops.
const gasClaimed = client.gasSafeNumber !== undefined
const gasNumber = known(client.gasSafeNumber)
const hasAnything = gasClaimed || client.insured
---

{
  hasAnything && (
    <section class="px-5 py-10" style="background: var(--surface);">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-2xl font-bold">Credentials</h2>
        <ul class="mt-4 space-y-2">
          {gasClaimed && (
            <li>
              Gas Safe registered
              {gasNumber ? <> — no. {gasNumber}</> : <> <Todo label="gas safe number" /></>}
            </li>
          )}
          {client.insured && <li>Fully insured</li>}
        </ul>
      </div>
    </section>
  )
}
