---
import { client } from '../config/client'
import { copy } from '../config/copy'
import { known } from '../lib/todo'
import Todo from './Todo.astro'

// undefined = not gas registered at all, so the whole line drops.
const gasClaimed = client.gasSafeNumber !== undefined
const gasNumber = known(client.gasSafeNumber)
const hasAnything = gasClaimed || client.insured
---

{
  hasAnything && (
    <section class="px-5 py-10" style="background: var(--surface);">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-2xl font-bold">{copy.credentialsHeading}</h2>
        <ul class="mt-4 space-y-2">
          {gasClaimed && (
            <li>
              {copy.gasSafe}
              {gasNumber ? <> {copy.gasSafeNumber(gasNumber)}</> : <> <Todo label={copy.todo.gasSafeNumber} /></>}
            </li>
          )}
          {client.insured && <li>{copy.insured}</li>}
        </ul>
      </div>
    </section>
  )
}
