---
import { client } from '../config/client'
import { copy } from '../config/copy'
import { known } from '../lib/todo'
import Todo from './Todo.astro'
import Icon from './Icon.astro'
import type { Credential } from '../config/client'

// undefined = no gas work at all, so the whole line drops.
const gas = client.gasSafe
const gasNumber = known(gas?.number)
const items: Credential[] = [
  ...(client.insured ? [{ text: copy.insured, icon: 'insured' as const }] : []),
  ...(client.credentials ?? []),
]
const hasAnything = gas !== undefined || items.length > 0
---

{
  hasAnything && (
    <section class="px-5 py-10">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-2xl font-bold">{copy.credentialsHeading}</h2>
        <ul class="mt-4 grid grid-cols-1 gap-x-6 gap-y-3 sm:grid-cols-2">
          {gas && (
            <li class="sm:col-span-2">
              {copy.gasSafe(gas.who, gas.engineer)}
              {gasNumber ? <> {copy.gasSafeNumber(gasNumber)}</> : <> <Todo label={copy.todo.gasSafeNumber} /></>}
            </li>
          )}
          {items.map((item) => (
            <li class="flex items-center gap-3">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full" style="background: var(--surface); color: var(--link);">
                {item.icon && <Icon name={item.icon} class="h-4 w-4" />}
              </span>
              {item.text}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
