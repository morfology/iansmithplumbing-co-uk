---
import { waLink, telLink } from '../lib/wa'
import type { Source } from '../lib/wa'
import { client } from '../config/client'
import { copy } from '../config/copy'
import { known } from '../lib/todo'
import Todo from './Todo.astro'

interface Props {
  source: Source
  /** Sticky-bar variant: tighter, no TODO badges (they're already on the hero). */
  compact?: boolean
}
const { source, compact = false } = Astro.props

const tel = telLink()
const wa = waLink(source)
const phone = known(client.phone)

const base =
  'tap flex-1 rounded-lg px-4 text-center font-semibold no-underline ' +
  (compact ? 'text-base py-2' : 'text-lg py-3')
const disabled = 'opacity-60 cursor-not-allowed'
---

<div class="flex w-full gap-3">
  {
    tel ? (
      <a
        href={tel}
        class={base}
        style="background: var(--call-bg); color: var(--call-ink);"
        data-track-event="call_click"
        data-track-source={source}
      >
        {copy.ctaCall}
      </a>
    ) : (
      <span class={`${base} ${disabled}`} style="background: var(--call-bg); color: var(--call-ink);" aria-disabled="true">
        {copy.ctaCall}
      </span>
    )
  }
  {
    wa ? (
      <a
        href={wa}
        class={base}
        style="background: var(--wa-bg); color: var(--wa-ink); border: 1px solid var(--wa-edge);"
        data-track-event="whatsapp_click"
        data-track-source={source}
      >
        {copy.ctaWhatsApp}
      </a>
    ) : (
      <span class={`${base} ${disabled}`} style="background: var(--wa-bg); color: var(--wa-ink); border: 1px solid var(--wa-edge);" aria-disabled="true">
        {copy.ctaWhatsApp}
      </span>
    )
  }
</div>

{
  !compact && (!tel || !wa || !phone) && (
    <p class="mt-2 flex flex-wrap gap-2">
      {!phone && <Todo label={copy.todo.phoneDisplay} />}
      {!tel && <Todo label={copy.todo.phoneLink} />}
      {!wa && <Todo label={copy.todo.whatsapp} />}
    </p>
  )
}
