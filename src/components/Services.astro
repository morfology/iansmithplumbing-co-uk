---
import { client } from '../config/client'
import { copy } from '../config/copy'

// Config order is the order: one list, one source of truth.
const { services } = client
---

<section class="px-5 py-10">
  <div class="mx-auto max-w-3xl">
    <h2 class="text-2xl font-bold">{copy.servicesHeading}</h2>
    <ul class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2">
      {
        services.map((service) => (
          <li
            class="flex items-center justify-between gap-3 rounded-lg border px-4 py-3"
            style="border-color: var(--border);"
          >
            <span>{service.name}</span>
            {service.emergency && (
              <span
                class="shrink-0 rounded px-2 py-0.5 text-xs font-bold uppercase"
                style="background: var(--badge-bg); color: var(--badge-text);"
              >
                {copy.emergencyBadge}
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>
