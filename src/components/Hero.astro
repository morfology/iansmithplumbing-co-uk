---
import { client } from '../config/client'
import { copy } from '../config/copy'
import { joinNames } from '../lib/seo'
import ButtonPair from './ButtonPair.astro'

const areaList = joinNames(client.areas.map((a) => a.name))
---

<section class="px-5 pt-10 pb-8" style="background: var(--surface);">
  <div class="mx-auto max-w-3xl">
    <p class="text-sm font-semibold tracking-wide uppercase" style="color: var(--muted);">
      {client.businessName}
    </p>
    <h1 class="mt-1 text-3xl leading-tight font-extrabold sm:text-4xl">
      {copy.heroHeading}
    </h1>
    <p class="mt-3 text-lg" style="color: var(--text);">
      {client.tagline}
    </p>
    <p class="mt-2 text-base" style="color: var(--muted);">
      {copy.heroCredentials(areaList)}
    </p>

    <div class="mt-6">
      <ButtonPair source="website" />
    </div>

    <p class="mt-3 text-sm" style="color: var(--muted);">
      {copy.awayStrap}
    </p>
  </div>
</section>
