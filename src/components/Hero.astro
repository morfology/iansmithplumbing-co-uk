---
import { Image } from 'astro:assets'
import { client } from '../config/client'
import { copy } from '../config/copy'
import { joinNames } from '../lib/seo'
import ButtonPair from './ButtonPair.astro'
import Rating from './Rating.astro'

const areaList = joinNames(client.areas.map((a) => a.name))

// Photos are referenced by filename in client.ts so the config stays plain data.
// The glob is eager and build-time — Astro still tree-shakes to the one file used.
const assets = import.meta.glob<{ default: ImageMetadata }>('../assets/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
})
const hero = client.heroImage ? assets[`../assets/${client.heroImage.file}`]?.default : undefined
---

<section class="px-5 pt-6 pb-8" style="background: var(--surface);">
  <div class="mx-auto grid max-w-3xl gap-6 sm:grid-cols-2 sm:items-center sm:gap-8">
    <div>
      <p class="text-sm font-semibold tracking-wide uppercase" style="color: var(--muted);">
        {client.businessName}
      </p>
      <h1 class="mt-1 text-3xl leading-tight font-extrabold sm:text-4xl">
        {copy.heroHeading}
      </h1>
      <p class="mt-3 text-lg" style="color: var(--text);">
        {client.tagline}
      </p>
      <p class="mt-2 text-base" style="color: var(--muted);">
        {copy.heroCredentials(areaList)}
      </p>

      <div class="mt-4">
        <Rating compact />
      </div>

      <div class="mt-4">
        <ButtonPair source="website" />
      </div>

      <p class="mt-3 text-sm" style="color: var(--muted);">
        {copy.awayStrap}
      </p>
    </div>

    {
      /* Above the buttons on a phone, beside them on a laptop. Explicit
         dimensions and an eager fetch: this is the LCP element on mobile. */
      hero && client.heroImage && (
        <Image
          src={hero}
          alt={client.heroImage.alt}
          widths={[480, 720, 960]}
          sizes="(min-width: 640px) 320px, 100vw"
          loading="eager"
          fetchpriority="high"
          class="order-first aspect-[16/9] w-full rounded-xl object-cover sm:order-none sm:aspect-[4/3]"
          style="border: 1px solid var(--border);"
        />
      )
    }
  </div>
</section>
