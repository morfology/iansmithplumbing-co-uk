---
import { client } from '../config/client'
import { known } from '../lib/todo'
import { joinNames } from '../lib/seo'
import ButtonPair from './ButtonPair.astro'
import Todo from './Todo.astro'

const areaNames = client.areas.map((a) => a.name)
// gasSafeNumber undefined = this client isn't gas registered, so the claim drops.
const gasClaimed = client.gasSafeNumber !== undefined
const gasKnown = known(client.gasSafeNumber)
---

<section class="px-5 pt-10 pb-8" style="background: var(--surface);">
  <div class="mx-auto max-w-3xl">
    <h1 class="text-3xl leading-tight font-extrabold sm:text-4xl">
      {client.businessName} — {client.tagline}
    </h1>

    <p class="mt-3 text-base" style="color: var(--muted);">
      {gasClaimed && <>Gas Safe registered{!gasKnown && <> <Todo label="confirm gas safe" /></>} · </>}
      {client.insured && <>fully insured · </>}
      covering {joinNames(areaNames)}
    </p>

    <div class="mt-6">
      <ButtonPair source="website" />
    </div>

    <p class="mt-3 text-sm" style="color: var(--muted);">
      Can't answer? Message me — I reply between jobs.
    </p>
  </div>
</section>
