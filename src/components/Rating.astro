---
import { client } from '../config/client'
import { copy } from '../config/copy'

/**
 * Third-party rating, shown as a badge. Two sizes: `compact` sits in the hero
 * directly above the buttons, the full one heads the reviews section.
 *
 * Deliberately not marked up as schema.org aggregateRating — see SCAFFOLD.
 */
interface Props {
  compact?: boolean
}
const { compact = false } = Astro.props

const rating = client.rating
const label = rating
  ? copy.rating.label(rating.score, rating.outOf, rating.count, rating.source, rating.asOf)
  : ''

// A link when there's a profile to send people to, plain text when there isn't.
const Tag = rating?.url ? 'a' : 'div'
const linkProps = rating?.url
  ? { href: rating.url, target: '_blank', rel: 'noopener noreferrer' }
  : {}
---

{
  rating && (
    <Tag
      {...linkProps}
      class:list={[
        'inline-flex items-center gap-2.5 border no-underline',
        // the dated summary can wrap in the narrow hero column — a pill with
        // two lines of text looks broken, a rounded box doesn't
        compact ? 'rounded-2xl px-3 py-1.5' : 'rounded-full px-4 py-2',
      ]}
      style="border-color: var(--border); background: var(--bg);"
      aria-label={label}
    >
      <span aria-hidden="true" class="flex shrink-0 items-baseline gap-0.5 whitespace-nowrap">
        <span class={compact ? 'text-lg font-extrabold' : 'text-2xl font-extrabold'}>
          {rating.score}
        </span>
        <span class="text-xs font-semibold" style="color: var(--muted);">
          {copy.rating.outOf(rating.outOf)}
        </span>
      </span>
      <span
        aria-hidden="true"
        class={compact ? 'text-sm' : 'text-base'}
        style="color: var(--muted);"
      >
        <span class="mr-1">·</span>{copy.rating.summary(rating.count, rating.source, rating.asOf)}
      </span>
    </Tag>
  )
}
