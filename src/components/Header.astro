---
import { Image } from 'astro:assets'
import { client } from '../config/client'
import { copy } from '../config/copy'
import { telLink } from '../lib/wa'
import { known } from '../lib/todo'
import { resolvePhoto } from '../lib/photo'
import Todo from './Todo.astro'

// The logo is square and opaque, so it goes in as a tile rather than a
// lockup — its own background then reads as deliberate instead of as a
// grey box someone forgot to cut out. Its wordmark is illegible at this
// size, which is why the business name stays as live text beside it.
const logo = resolvePhoto(client.logo)

// The name links home — the area pages need a way back. Otherwise no nav:
// one page, one job. The header exists to anchor the page
// with the business name and to put the number somewhere other than a button.
const phone = known(client.phone)
const tel = telLink()
---

<header class="on-accent px-5 py-3">
  <div class="mx-auto flex max-w-3xl items-center justify-between gap-3">
    <a href="/" class="flex min-w-0 items-center gap-3 no-underline" style="color: var(--text);">
      {
        logo && client.logo && (
          <Image
            src={logo}
            alt=""
            widths={[64, 128, 160]}
            sizes="(min-width: 640px) 80px, 64px"
            loading="eager"
            class="h-16 w-16 shrink-0 rounded-xl object-cover shadow-md sm:h-20 sm:w-20"
          />
        )
      }
      <p class="truncate text-lg font-extrabold sm:text-xl">{client.businessName}</p>
    </a>
    {
      tel && phone ? (
        <a
          href={tel}
          class="tap font-bold whitespace-nowrap no-underline sm:text-lg"
          style="color: var(--link);"
          aria-label={copy.headerCallLabel(phone)}
          data-track-event="call_click"
          data-track-source="header"
        >
          {phone}
        </a>
      ) : (
        <Todo label={copy.todo.phone} />
      )
    }
  </div>
</header>
