---
import { client } from '../config/client'
import { copy } from '../config/copy'

interface Props {
  /** On an area page: that area's slug, left out of the list. */
  current?: string
}
const { current } = Astro.props
const { baseTown } = client
const areas = client.areas.filter((a) => a.slug !== current)
---

{
  areas.length > 0 && (
    <section class="px-5 py-10">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-2xl font-bold">{current ? copy.otherAreasHeading : copy.areasHeading}</h2>
        <p class="mt-2" style="color: var(--muted);">
          {copy.areasIntro(baseTown)}
        </p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {areas.map((area) => (
            <li>
              <a
                href={`/areas/${area.slug}/`}
                class="tap rounded-lg border px-4 no-underline"
                style="border-color: var(--border); color: var(--text);"
              >
                {area.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
