---
import { copy } from '../config/copy'
import ButtonPair from './ButtonPair.astro'

// Someone who reads to the bottom has decided — don't make them scroll back up.
---

<section class="on-accent px-5 py-12">
  <div class="mx-auto max-w-3xl text-center">
    <h2 class="text-2xl font-extrabold sm:text-3xl">{copy.callBandHeading}</h2>
    <p class="mt-2" style="color: var(--muted);">{copy.awayStrap}</p>
    <div class="mx-auto mt-5 max-w-md">
      <ButtonPair source="website" />
    </div>
  </div>
</section>
