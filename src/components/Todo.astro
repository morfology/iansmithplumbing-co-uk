---
/** Visible placeholder for a config value we don't know yet. Impossible to miss,
    so nothing ships with a TODO still in it. */
interface Props {
  label: string
}
const { label } = Astro.props
---

<mark
  class="inline-block rounded px-1.5 py-0.5 text-xs font-bold tracking-wide uppercase"
  style="background: var(--todo-bg); color: var(--todo-text);"
>
  TODO — {label}
</mark>
