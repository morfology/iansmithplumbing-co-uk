---
import { client } from '../config/client'
import { copy } from '../config/copy'
import { known } from '../lib/todo'
import Rating from './Rating.astro'

const { reviews, rating } = client
const reviewLink = known(rating?.url)
---

{
  /* A verified score with a link to the profile stands on its own — the section
     no longer needs quotes to justify itself. */
  (reviews.length > 0 || rating) && (
    <section class="px-5 py-10" style="background: var(--surface);">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-2xl font-bold">{copy.reviewsHeading}</h2>
        {rating && (
          <p class="mt-3">
            <Rating />
          </p>
        )}
        {reviews.length > 0 && (
        <ul class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {reviews.map((review, i) => (
            <li
              class:list={[
                'rounded-lg border p-4',
                // odd count leaves a dangling card — let the last one span the row
                i === reviews.length - 1 && reviews.length % 2 === 1 && 'sm:col-span-2',
              ]}
              style="border-color: var(--border);"
            >
              <blockquote class="italic">"{review.quote}"</blockquote>
              <p class="mt-2 text-sm" style="color: var(--muted);">
                {copy.reviewAttribution(review.author, review.source)}
              </p>
            </li>
          ))}
        </ul>
        )}
        {reviewLink && rating && (
          <p class="mt-4">
            <a
              href={reviewLink}
              target="_blank"
              rel="noopener noreferrer"
              class="underline"
              style="color: var(--link);"
            >
              {copy.moreReviews(rating.source)}
            </a>
          </p>
        )}
      </div>
    </section>
  )
}
