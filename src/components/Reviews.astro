---
import { client } from '../config/client'
import { known } from '../lib/todo'

const { reviews, googleReviewUrl } = client
const reviewLink = known(googleReviewUrl)
---

{
  reviews.length > 0 && (
    <section class="px-5 py-10">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-2xl font-bold">What people say</h2>
        <ul class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {reviews.map((review) => (
            <li class="rounded-lg border p-4" style="border-color: var(--border);">
              <blockquote class="italic">"{review.quote}"</blockquote>
              <p class="mt-2 text-sm" style="color: var(--muted);">
                — {review.author}
                {review.source && <>, {review.source}</>}
              </p>
            </li>
          ))}
        </ul>
        {reviewLink && (
          <p class="mt-4">
            <a href={reviewLink} class="underline" style="color: var(--link);">
              Read more reviews
            </a>
          </p>
        )}
      </div>
    </section>
  )
}
